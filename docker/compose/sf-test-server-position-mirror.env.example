# Copy to /etc/traccar-dev/position-mirror.env with mode 600.
# Replace every angle-bracket placeholder; never commit real credentials.
TRACCAR_POSITION_MIRROR_IMAGE=python:3.12-alpine@sha256:<approved-digest>
TRACCAR_POSITION_MIRROR_SOURCE_URL=https://<production-traccar-host>
TRACCAR_POSITION_MIRROR_SOURCE_HOST=<production-traccar-host>
TRACCAR_POSITION_MIRROR_SOURCE_TOKEN=<approved-read-only-token>
TRACCAR_POSITION_MIRROR_DEVICE_IDS=<comma-separated-approved-device-ids>
TRACCAR_POSITION_MIRROR_POLL_SECONDS=10
TRACCAR_POSITION_MIRROR_LOOKBACK_SECONDS=60
TRACCAR_POSITION_MIRROR_DRY_RUN=true
TRACCAR_POSITION_MIRROR_APPROVAL_REFERENCE=<approval-record-id>
TRACCAR_POSITION_FORWARD_URL=https://sf-test-server.tail056d0a.ts.net/fleet-test/api/v1/internal/gps/traccar/positions
TRACCAR_POSITION_FORWARD_HEADER=Authorization: Bearer <fleet-test-position-secret>
