diff --git a/src/map/legend/MapSmartGoLegend.js b/src/map/legend/MapSmartGoLegend.js
new file mode 100644
--- /dev/null
+++ b/src/map/legend/MapSmartGoLegend.js
@@ -0,0 +1,123 @@
+import { useEffect, useMemo } from 'react';
+import { useSelector } from 'react-redux';
+import { useTheme } from '@mui/material';
+import { map } from '../core/MapView';
+import './smartgoLegend.css';
+
+const LOCATION_LABELS = {
+  machine: 'Machines',
+  warehouse: 'Warehouses',
+  customer: 'Customers',
+  supplier: 'Suppliers',
+};
+
+const fallbackColor = '#2563EB';
+
+const colorFor = (geofence) => geofence.attributes?.color || fallbackColor;
+
+const routeLabel = (geofence) => geofence.name || `Route ${geofence.id}`;
+
+const locationLabel = (locationType) => LOCATION_LABELS[locationType] || 'Locations';
+
+const buildLegendItems = (geofences) => {
+  const routeItems = [];
+  const locationItems = new Map();
+
+  Object.values(geofences).forEach((geofence) => {
+    if (geofence.attributes?.hide) {
+      return;
+    }
+    const bindingKind = geofence.attributes?.smartgo_binding_kind;
+    const locationType = geofence.attributes?.smartgo_location_type;
+    const color = colorFor(geofence);
+    if (bindingKind === 'route_polyline') {
+      routeItems.push({
+        key: `route:${geofence.id}`,
+        label: routeLabel(geofence),
+        color,
+        line: true,
+      });
+    } else if (locationType) {
+      const key = `location:${locationType}:${color}`;
+      if (!locationItems.has(key)) {
+        locationItems.set(key, {
+          key,
+          label: locationLabel(locationType),
+          color,
+          line: false,
+        });
+      }
+    }
+  });
+
+  return [
+    ...routeItems.sort((first, second) => first.label.localeCompare(second.label)),
+    ...Array.from(locationItems.values()).sort((first, second) =>
+      first.label.localeCompare(second.label),
+    ),
+  ];
+};
+
+class SmartGoLegendControl {
+  onAdd() {
+    this.container = document.createElement('div');
+    this.container.className = 'maplibregl-ctrl smartgo-map-legend';
+    this.update([]);
+    return this.container;
+  }
+
+  onRemove() {
+    this.container?.parentNode?.removeChild(this.container);
+    this.container = null;
+  }
+
+  update(items) {
+    if (!this.container) {
+      return;
+    }
+    this.container.replaceChildren();
+    this.container.style.display = items.length ? '' : 'none';
+
+    if (!items.length) {
+      return;
+    }
+
+    const title = document.createElement('div');
+    title.className = 'smartgo-map-legend-title';
+    title.textContent = 'SmartGo Legend';
+    this.container.appendChild(title);
+
+    const list = document.createElement('div');
+    list.className = 'smartgo-map-legend-list';
+    items.forEach((item) => {
+      const row = document.createElement('div');
+      row.className = 'smartgo-map-legend-row';
+
+      const swatch = document.createElement('span');
+      swatch.className = item.line
+        ? 'smartgo-map-legend-swatch smartgo-map-legend-swatch-line'
+        : 'smartgo-map-legend-swatch';
+      swatch.style.backgroundColor = item.color;
+
+      const label = document.createElement('span');
+      label.className = 'smartgo-map-legend-label';
+      label.textContent = item.label;
+
+      row.appendChild(swatch);
+      row.appendChild(label);
+      list.appendChild(row);
+    });
+    this.container.appendChild(list);
+  }
+}
+
+const MapSmartGoLegend = () => {
+  const theme = useTheme();
+  const geofences = useSelector((state) => state.geofences.items);
+  const control = useMemo(() => new SmartGoLegendControl(), []);
+  const items = useMemo(() => buildLegendItems(geofences), [geofences]);
+
+  useEffect(() => {
+    map.addControl(control, theme.direction === 'rtl' ? 'bottom-right' : 'bottom-left');
+    return () => map.removeControl(control);
+  }, [control, theme.direction]);
+
+  useEffect(() => {
+    control.update(items);
+  }, [control, items]);
+
+  return null;
+};
+
+export default MapSmartGoLegend;
diff --git a/src/map/legend/smartgoLegend.css b/src/map/legend/smartgoLegend.css
new file mode 100644
--- /dev/null
+++ b/src/map/legend/smartgoLegend.css
@@ -0,0 +1,48 @@
+.smartgo-map-legend {
+  max-width: 260px;
+  max-height: 42vh;
+  overflow: auto;
+  padding: 8px 10px;
+  border-radius: 4px;
+  background: rgba(255, 255, 255, 0.94);
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.24);
+  color: #202124;
+  font:
+    12px/1.35 Arial,
+    sans-serif;
+}
+
+.smartgo-map-legend-title {
+  margin-bottom: 6px;
+  font-weight: 700;
+}
+
+.smartgo-map-legend-list {
+  display: grid;
+  gap: 5px;
+}
+
+.smartgo-map-legend-row {
+  display: grid;
+  grid-template-columns: 18px minmax(0, 1fr);
+  align-items: center;
+  column-gap: 7px;
+}
+
+.smartgo-map-legend-swatch {
+  width: 12px;
+  height: 12px;
+  border: 1px solid rgba(0, 0, 0, 0.22);
+  border-radius: 50%;
+}
+
+.smartgo-map-legend-swatch-line {
+  width: 18px;
+  height: 4px;
+  border: 0;
+  border-radius: 2px;
+}
+
+.smartgo-map-legend-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
